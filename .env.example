# Copy to .dev.vars and fill with your own keys. Never commit .dev.vars.
# Local dev reads this file; production uses `wrangler secret put <NAME>`.

# Model provider (only "google" is wired in this POC)
AI_PROVIDER=google
LLM_API_KEY=your-gemini-api-key

# Discovery quality (Parallel AI)
PARALLEL_API_KEY=your-parallel-api-key

# Repo push (fine-grained personal access token, repo scope)
GITHUB_TOKEN=your-github-token

# Digest + password-reset email (Resend; domain must be verified)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM="Caddie <you@yourdomain.dev>"
